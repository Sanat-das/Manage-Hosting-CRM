# The test environment's settings, committed on purpose.
#
# A fresh checkout (CI, a new server, a colleague) has no .env — it is
# gitignored and holds the real credentials. Without these values the suite
# runs against a different application than the one it is testing:
#
#  - APP_TIMEZONE defaults to UTC, while the application runs on
#    Asia/Kolkata. A day-boundary difference is enough to move a billing
#    anchor by one day, and the once-per-cycle guard then skips a renewal
#    that should have billed.
#  - APP_KEY is missing, so anything that encrypts a cookie or a session
#    cannot work.
#
# Everything here is test-only: a fixed key, no real host, no real mail.
# phpunit.xml still pins the database, cache, session, queue and mailer.
APP_ENV=testing
APP_KEY=base64:08fuTOoNbghLESzPuk//uyk+erNMv1nMO8oLaOf1HC8=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array
