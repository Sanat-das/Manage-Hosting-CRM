<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Laravel front-controller URL rewriting (equivalent of public/.htaccess) -->
    <rewrite>
      <rules>
        <rule name="Laravel Trailing Slash Redirect" stopProcessing="true">
          <match url="(.*)/$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Laravel Front Controller" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- Lock down sensitive app paths.
         NOTE: the site root is public/, so app/, config/, database/, routes/,
         tests/, artisan, composer.json and the real Composer vendor/ all live
         ABOVE the web root and are already unreachable by URL. The entries
         below are belt-and-braces for misconfigured roots only.
         Do NOT add "storage" or "vendor" here: public/storage (the storage:link
         junction, serves uploaded branding) and public/vendor (trix, apexcharts,
         fullcalendar, jsvectormap, sortablejs, adminlte) are meant to be public.
         hiddenSegments matches ANY segment in the path, so those two entries
         404.8 every upload and every asset('vendor/...') on IIS. -->
    <security>
      <requestFiltering>
        <hiddenSegments applyToWebDAV="true">
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".codegraph" />
          <add segment="bootstrap" />
          <add segment="config" />
          <add segment="database" />
          <add segment="resources" />
          <add segment="sql" />
          <add segment="tests" />
          <add segment="routes" />
          <add segment="node_modules" />
          <add segment="artisan" />
          <add segment="composer.json" />
          <add segment="composer.lock" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
          <add segment="vite.config.js" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="Default.htm" />
        <add value="Default.asp" />
        <add value="index.htm" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="DetailedLocalOnly" />

    <!-- Static asset caching for the Vite build -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
      <!-- IIS has no default MIME map for .webp/.avif and refuses to serve an
           unmapped extension (404.3). Branding renders the logo as
           <picture><source type="image/webp"><img src=".png">, and a <picture>
           does NOT fall back to the <img> when the chosen <source> 404s - so
           without these the logo is a broken image everywhere on IIS while
           working fine on Apache. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
  </system.webServer>
</configuration>