APP_NAME=HostVexa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production must use https:// for APP_URL. SESSION_SECURE_COOKIE is written by
# the installer from the scheme the wizard was submitted over — see below.
# Set to true to force HTTPS redirects/scheme when behind a TLS-terminating proxy.
APP_FORCE_HTTPS=false
APP_INSTALLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_HOST=
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# SNMP Monitor dedicated time-series database (used when DB_CONNECTION=mysql/mariadb)
MONITORING_DB_DATABASE=managehosting_monitoring
# Days of per-host samples retained before snmp:maintain-partitions drops a monthly partition
# MONITORING_RETENTION_DAYS=35

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Off by default because this file is the PRE-INSTALL environment: a Secure
# cookie is discarded by the browser over plain http, which loses the session
# and turns every installer POST into a 419. InstallerService::run() rewrites
# this from the scheme the wizard was submitted over, so an https install ends
# up with true. Behind a TLS-terminating proxy set it to true by hand.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Set to "reverb" to turn on real-time chat. Left as "log" here because this
# file is the pre-install environment and no Reverb process is running yet:
# with "reverb" every chat send would try to publish to a dead socket.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Laravel Reverb (websocket server for the Slack-like chat) ---
# REVERB_APP_ID/KEY/SECRET identify this application to the Reverb server.
# Generate them once per install: the key is public (the browser sees it), the
# secret is not.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Where the Reverb process itself listens. Bound to loopback on purpose: on
# Windows/IIS the public traffic arrives through the IIS reverse proxy, so the
# socket server is never exposed directly. See scripts/reverb-service.ps1.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081

# How the PHP application reaches Reverb when it publishes an event.
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

# How the BROWSER reaches Reverb. Behind IIS+TLS these become the public host
# with VITE_REVERB_SCHEME=https and VITE_REVERB_PORT=443, so the client dials
# wss://. They are compiled into the JS bundle by Vite — public values only.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Windows Server (RDP) HTML5 console - guacamole-lite Node sidecar
GUACAMOLE_WS_URL=ws://127.0.0.1:8080/
# Shared secret for connection tokens, min 16 chars (openssl rand -base64 32)
GUACAMOLE_SECRET=
# Session recording directory; blank disables recording
GUACAMOLE_RECORDING_PATH=
