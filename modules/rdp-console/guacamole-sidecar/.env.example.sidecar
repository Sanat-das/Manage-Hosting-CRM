# rdp-console-guacamole-sidecar environment
# Copy to .env (or set via NSSM/winsw service environment) next to server.js.
# GUACAMOLE_SECRET MUST be byte-identical to the Laravel module's config('rdp-console.secret').

# Port the sidecar's WebSocket server listens on (clients connect to ws://host:PORT/)
GUAC_WS_PORT=8080

# guacd host (keep on same host / localhost-only)
GUACD_HOST=127.0.0.1

# guacd port (guacd default is 4822)
GUACD_PORT=4822

# Shared token-encryption secret, >= 16 chars (AES-256-CBC key material).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUACAMOLE_SECRET=
